{
  "schemaVersion": 2,
  "id": "com.t3code.veritas",
  "displayName": "Veritas verification cockpit",
  "version": "0.3.0",
  "description": "Veritas verification runs, stations, suites, failures and firmware provenance, with a human-approved evidence review for starting runs.",
  "mcpServer": {
    "name": "veritas",
    "transport": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "${pluginRoot}/src/mcp.ts"
      ],
      "env": [
        {
          "name": "VERITAS_URL",
          "value": "https://veritas.forgegraf.com",
          "title": "Veritas endpoint"
        },
        {
          "name": "VERITAS_TOKEN",
          "value": "",
          "sensitive": true,
          "title": "Veritas token",
          "description": "Veritas CLI token (vrt_…). Reading needs runs:read and config:read; starting runs needs runs:trigger."
        },
        {
          "name": "VERITAS_DEFAULT_SUITE_ID",
          "value": "",
          "title": "Default verification suite",
          "description": "Optional suite id that filters runs and prefills the evidence review."
        },
        {
          "name": "VERITAS_POLL_SECONDS",
          "value": "60",
          "title": "Refresh interval in seconds (15-3600)"
        }
      ]
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "veritas-cockpit",
        "title": "Verification summary",
        "scope": "project",
        "resourceUri": "ui://veritas/cockpit.html",
        "tool": { "name": "veritas_cockpit", "arguments": {} }
      },
      {
        "id": "veritas-thread",
        "title": "Thread verification",
        "scope": "thread",
        "resourceUri": "ui://veritas/evidence-review.html",
        "tool": { "name": "veritas_evidence_review", "arguments": {} }
      }
    ],
    "commands": [
      {
        "id": "veritas-refresh",
        "title": "Veritas: Refresh verification status",
        "panel": "veritas-cockpit"
      },
      {
        "id": "veritas-open-run",
        "title": "Veritas: Open verification runs",
        "panel": "veritas-cockpit"
      },
      {
        "id": "veritas-trigger-run",
        "title": "Veritas: Start verification run",
        "panel": "veritas-thread"
      }
    ]
  },
  "t3Tools": []
}
