{
  "schemaVersion": 2,
  "id": "com.t3code.veritas",
  "displayName": "Veritas verification cockpit",
  "version": "0.4.0",
  "description": "Review workspace verification runs, suites, station availability, and firmware provenance through Veritas OAuth.",
  "mcpServer": {
    "name": "veritas",
    "transport": {
      "type": "http",
      "url": "https://veritas.forgegraf.com/api/mcp",
      "headers": [],
      "auth": {
        "type": "oauth",
        "scopes": [
          "config:read",
          "runs:read",
          "stations:read",
          "firmware:read"
        ]
      }
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "veritas-cockpit",
        "title": "Verification summary",
        "scope": "project",
        "resourceUri": "ui://veritas/cockpit.html",
        "tool": {
          "name": "veritas_cockpit",
          "arguments": {}
        }
      },
      {
        "id": "veritas-thread",
        "title": "Thread verification",
        "scope": "thread",
        "resourceUri": "ui://veritas/evidence-review.html",
        "tool": {
          "name": "veritas_evidence_review",
          "arguments": {}
        }
      }
    ],
    "commands": [
      {
        "id": "veritas-refresh",
        "title": "Veritas: Refresh verification status",
        "panel": "veritas-cockpit"
      },
      {
        "id": "veritas-open-run",
        "title": "Veritas: Open verification runs",
        "panel": "veritas-cockpit"
      },
      {
        "id": "veritas-open-evidence",
        "title": "Veritas: Review verification evidence",
        "panel": "veritas-thread"
      }
    ]
  },
  "t3Tools": []
}
